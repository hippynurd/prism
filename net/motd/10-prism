#!/bin/sh
# /etc/update-motd.d/10-prism
# PRISM identity banner - displayed on every login

use_color=1
if [ "${TERM:-}" = "dumb" ] || [ -n "${NO_COLOR:-}" ]; then
  use_color=0
fi

color() {
  if [ "$use_color" -eq 1 ]; then
    printf '\033[%sm' "$1"
  fi
}

reset_color() {
  if [ "$use_color" -eq 1 ]; then
    printf '\033[0m'
  fi
}

banner_line() {
  color '1;38;5;196'
  printf '%s' "$1"
  color '1;38;5;220'
  printf '%s' "$2"
  color '1;38;5;46'
  printf '%s' "$3"
  color '1;38;5;33'
  printf '%s' "$4"
  color '1;38;5;201'
  printf '%s' "$5"
  reset_color
  printf '\n'
}

word() {
  color "$1"
  printf '%s' "$2"
  reset_color
}

dot() {
  color '1;37'
  printf ' · '
  reset_color
}

printf '\n'
banner_line '  ██████╗ ' '██████╗ ' '██╗' '███████╗' '███╗   ███╗'
banner_line '  ██╔══██╗' '██╔══██╗' '██║' '██╔════╝' '████╗ ████║'
banner_line '  ██████╔╝' '██████╔╝' '██║' '███████╗' '██╔████╔██║'
banner_line '  ██╔═══╝ ' '██╔══██╗' '██║' '╚════██║' '██║╚██╔╝██║'
banner_line '  ██║     ' '██║  ██║' '██║' '███████║' '██║ ╚═╝ ██║'
banner_line '  ╚═╝     ' '╚═╝  ╚═╝' '╚═╝' '╚══════╝' '╚═╝     ╚═╝'
printf '\n'
printf '  '
word '1;38;5;196' 'Private'
dot
word '1;38;5;220' 'Resilient'
dot
word '1;38;5;46' 'Independent'
dot
word '1;38;5;33' 'Sustainable'
dot
word '1;38;5;201' 'Modular'
printf '\n'
printf '\n'
printf '  Open browser to '
word '1;38;5;46' 'http://prism.local'
printf ' to get started.\n'
printf '\n'
