<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PRISM | Iris</title>
  <style>
    :root {
      --bg: #0d0d0d;
      --bg-soft: #141414;
      --panel: rgba(20, 20, 20, 0.94);
      --panel-strong: rgba(28, 28, 30, 0.98);
      --border: rgba(255, 255, 255, 0.08);
      --text: #e0e0e0;
      --muted: #a0a0a8;
      --magenta: #d46cff;
      --red: #ff5f5f;
      --yellow: #ffd75f;
      --green: #7dff8b;
      --cyan: #63e7ff;
      --shadow: 0 18px 48px rgba(0, 0, 0, 0.38);
      --radius: 18px;
      --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      --sans: "Segoe UI", "Helvetica Neue", "Noto Sans", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      background:
        radial-gradient(circle at top left, rgba(212, 108, 255, 0.16), transparent 24rem),
        radial-gradient(circle at top right, rgba(99, 231, 255, 0.14), transparent 24rem),
        linear-gradient(180deg, #151515 0%, #0d0d0d 100%);
      color: var(--text);
      font-family: var(--sans);
    }

    body {
      padding: 1rem;
    }

    .app {
      width: min(1080px, 100%);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 1rem;
      min-height: calc(100vh - 2rem);
    }

    .panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      backdrop-filter: blur(14px);
    }

    .sidebar {
      padding: 1.25rem;
      position: sticky;
      top: 1rem;
      align-self: start;
    }

    .ascii {
      margin: 0 0 1rem;
      overflow-x: hidden;
      white-space: pre;
      font-family: var(--mono);
      font-size: 0.55rem;
      line-height: 1.08;
    }

    .c-magenta { color: var(--magenta); }
    .c-red { color: var(--red); }
    .c-yellow { color: var(--yellow); }
    .c-green { color: var(--green); }
    .c-cyan { color: var(--cyan); }

    .eyebrow {
      margin: 0 0 0.5rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.74rem;
    }

    .brand-row {
      display: flex;
      align-items: baseline;
      gap: 0.65rem;
      margin-bottom: 0.85rem;
    }

    .brand-row h1,
    .chat-title h2,
    .section h3,
    p {
      margin: 0;
    }

    .brand-row h1 {
      font-size: 1.85rem;
      line-height: 1;
    }

    .iris-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.3rem 0.68rem;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--magenta), var(--red), var(--yellow), var(--green), var(--cyan));
      color: #111;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .intro {
      color: var(--muted);
      line-height: 1.55;
      margin-bottom: 1.1rem;
    }

    .mode-pill {
      display: inline-block;
      margin-bottom: 1rem;
      padding: 0.35rem 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.03);
      font-size: 0.78rem;
      color: var(--text);
    }

    .section + .section {
      margin-top: 1rem;
    }

    .section h3 {
      margin-bottom: 0.45rem;
      font-size: 0.94rem;
    }

    .status-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .status-list li {
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      color: var(--muted);
      line-height: 1.45;
    }

    .status-list li:last-child {
      border-bottom: 0;
    }

    .chat-shell {
      display: flex;
      flex-direction: column;
      min-height: calc(100vh - 2rem);
      background: var(--panel-strong);
      overflow: hidden;
    }

    .chat-header {
      padding: 1.05rem 1.1rem 0.95rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent);
    }

    .chat-title {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      margin-bottom: 0.45rem;
    }

    .chat-title h2 {
      font-size: 1.1rem;
    }

    .chat-subtitle {
      color: var(--muted);
      line-height: 1.5;
    }

    .chat-log {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      scroll-behavior: smooth;
    }

    .message-wrap {
      display: flex;
      margin-bottom: 0.9rem;
    }

    .message-wrap.user {
      justify-content: flex-end;
    }

    .message-wrap.assistant,
    .message-wrap.system {
      justify-content: flex-start;
    }

    .message {
      width: min(100%, 48rem);
      padding: 0.9rem 1rem;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.03);
      line-height: 1.6;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
    }

    .message.user {
      background: rgba(99, 231, 255, 0.08);
    }

    .message.assistant {
      background: rgba(255, 255, 255, 0.025);
      border-left: 4px solid var(--magenta);
    }

    .message.system {
      background: rgba(255, 255, 255, 0.025);
      color: var(--muted);
    }

    .message-meta {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.45rem;
      font-size: 0.78rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .message-body {
      white-space: pre-wrap;
      word-break: break-word;
    }

    .typing {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .typing span {
      width: 0.46rem;
      height: 0.46rem;
      border-radius: 999px;
      background: linear-gradient(180deg, var(--magenta), var(--cyan));
      opacity: 0.3;
      animation: prism-pulse 1.2s infinite ease-in-out;
    }

    .typing span:nth-child(2) { animation-delay: 0.15s; }
    .typing span:nth-child(3) { animation-delay: 0.3s; }

    @keyframes prism-pulse {
      0%, 80%, 100% { opacity: 0.28; transform: translateY(0); }
      40% { opacity: 1; transform: translateY(-2px); }
    }

    .composer {
      position: sticky;
      bottom: 0;
      padding: 0.95rem 1rem 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      background: linear-gradient(180deg, rgba(13, 13, 13, 0.5), rgba(18, 18, 18, 0.96));
      backdrop-filter: blur(10px);
    }

    .composer-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
      align-items: end;
    }

    .composer textarea {
      width: 100%;
      min-height: 3.4rem;
      max-height: 12rem;
      resize: vertical;
      padding: 0.9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #141414;
      color: var(--text);
      font: inherit;
      line-height: 1.5;
    }

    .composer textarea:focus,
    .composer button:focus {
      outline: 2px solid rgba(99, 231, 255, 0.45);
      outline-offset: 2px;
    }

    .composer button {
      border: 0;
      border-radius: 14px;
      padding: 0.95rem 1.2rem;
      min-width: 7.25rem;
      font: inherit;
      font-weight: 700;
      color: #111;
      background: linear-gradient(90deg, var(--magenta), var(--red), var(--yellow), var(--green), var(--cyan));
      cursor: pointer;
    }

    .composer button[disabled] {
      cursor: wait;
      opacity: 0.65;
    }

    .composer-note {
      margin-top: 0.65rem;
      color: var(--muted);
      font-size: 0.87rem;
      line-height: 1.45;
    }

    @media (max-width: 900px) {
      .app {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
      }

      .chat-shell {
        min-height: 75vh;
      }
    }

    @media (max-width: 560px) {
      body {
        padding: 0.65rem;
      }

      .sidebar,
      .chat-shell {
        border-radius: 16px;
      }

      .sidebar {
        padding: 1rem;
      }

      .ascii {
        font-size: 0.55rem;
      }

      .composer-row {
        grid-template-columns: 1fr;
      }

      .composer button {
        width: 100%;
      }
    }
  </style>
</head>
